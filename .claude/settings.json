{
  "version": "2.0",
  "description": "Comprehensive Claude Code Configuration for Multi-Disciplinary SaaS and Data Engineering",
  "permissions_strategy": "Optimized allowlist for full-stack development with minimal permission prompts. Covers: Git, Node.js/TypeScript, Python, SQL, Docker, Testing, Linting, and Build tools.",

  "model": {
    "default": "claude-haiku-4-5-20251001",
    "reasoning-effort": "medium",
    "temperature": 0.8,
    "max-tokens": 8096,
    "overrides": {
      "code-review": "claude-opus-5",
      "architecture-planning": "claude-opus-5",
      "data-pipeline-design": "claude-sonnet-5",
      "quick-tasks": "claude-haiku-4-5-20251001"
    }
  },

  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git pull *)",
      "Bash(git branch *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git status)",
      "Bash(git log *)",
      "Bash(npm *)",
      "Bash(npm install)",
      "Bash(npm start)",
      "Bash(npm run *)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(yarn install)",
      "Bash(yarn start)",
      "Bash(yarn test)",
      "Bash(yarn build)",
      "Bash(node *)",
      "Bash(tsx *)",
      "Bash(ts-node *)",
      "Bash(tsc *)",
      "Bash(python*)",
      "Bash(python3 *)",
      "Bash(python -m *)",
      "Bash(pip *)",
      "Bash(pip install *)",
      "Bash(pip3 *)",
      "Bash(pytest *)",
      "Bash(pytest --*)",
      "Bash(poetry *)",
      "Bash(poetry run *)",
      "Bash(psql *)",
      "Bash(mysql *)",
      "Bash(mongosh *)",
      "Bash(docker *)",
      "Bash(docker-compose *)",
      "Bash(docker ps)",
      "Bash(docker logs *)",
      "Bash(docker exec *)",
      "Bash(docker build *)",
      "Bash(docker run *)",
      "Bash(eslint *)",
      "Bash(eslint --fix *)",
      "Bash(prettier *)",
      "Bash(prettier --write *)",
      "Bash(black *)",
      "Bash(ruff *)",
      "Bash(ruff check *)",
      "Bash(ruff format *)",
      "Bash(jest *)",
      "Bash(mocha *)",
      "Bash(vitest *)",
      "Bash(webpack *)",
      "Bash(vite *)",
      "Bash(esbuild *)",
      "Bash(tsup *)",
      "Bash(make *)",
      "Bash(make build)",
      "Bash(make test)",
      "Bash(make dev)",
      "Bash(cp -r *)",
      "Bash(mv *)",
      "Bash(rm -rf *)",
      "Bash(mkdir -p *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(ls *)",
      "Bash(ls -la *)",
      "Bash(find *)",
      "Bash(find . -name *)",
      "Bash(grep *)",
      "Bash(grep -r *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(echo *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(xargs *)",
      "Bash(which *)",
      "Bash(whereis *)",
      "Bash(type *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git clone *)",
      "Bash(claude *)",
      "Bash(claude --version)",
      "Bash(claude loop *)",
      "Bash(claude mem *)",
      "Bash(claude plugin *)",
      "Bash(claude rule *)",
      "Bash(claude workflow *)"
    ]
  },

  "hooks": {
    "pre-commit": {
      "stage": "pre-commit-quality-check",
      "enabled": true,
      "commands": [
        "echo 'Running pre-commit checks...'",
        "echo 'Checks completed'"
      ]
    },
    "post-commit": {
      "stage": "post-commit-hooks",
      "enabled": false
    },
    "pre-push": {
      "stage": "pre-push-validation",
      "enabled": false
    }
  },

  "workflows": {
    "auto-save": true,
    "save-interval": "5m",
    "max-concurrent-agents": 10,
    "budget": {
      "enabled": false,
      "tokens": null
    }
  },

  "loops": {
    "auto-save": true,
    "default-interval": "5m",
    "max-idle-duration": "1h",
    "fallback-check-interval": "1200s"
  },

  "memory": {
    "enabled": true,
    "auto-save": true,
    "max-memories": 5000,
    "cleanup-interval": "7d",
    "types": {
      "user": true,
      "feedback": true,
      "project": true,
      "reference": true
    }
  },

  "mcpServers": {
    "claude-mem": {
      "enabled": true,
      "description": "Memory and knowledge management"
    },
    "github": {
      "enabled": true,
      "command": "mcp-github",
      "description": "GitHub MCP Server - Repository management, issues, PRs"
    },
    "typescript-lsp": {
      "enabled": true,
      "command": "typescript-language-server",
      "description": "TypeScript Language Server Protocol"
    },
    "rust-lsp": {
      "enabled": true,
      "command": "rust-analyzer",
      "description": "Rust Language Server Protocol"
    },
    "local-review": {
      "enabled": true,
      "command": "mcp-local-review",
      "description": "Local code review and analysis"
    },
    "playwright": {
      "enabled": true,
      "command": "mcp-playwright",
      "description": "Playwright testing automation"
    }
  },

  "plugins": {
    "claude-mem": {
      "enabled": true,
      "config": {
        "auto-save": true,
        "max-memories": 5000
      }
    },
    "security-review": {
      "enabled": true,
      "config": {
        "auto-check": true,
        "level": "medium"
      }
    },
    "typescript-lsp": {
      "enabled": true,
      "config": {
        "auto-check": true,
        "strict-mode": true
      }
    },
    "rust-lsp": {
      "enabled": true,
      "config": {
        "auto-check": true
      }
    },
    "local-review": {
      "enabled": true,
      "config": {
        "auto-review": true,
        "level": "quick"
      }
    },
    "codeex": {
      "enabled": true,
      "config": {
        "enabled": true
      }
    },
    "superpowers": {
      "enabled": true,
      "config": {
        "features": "all"
      }
    },
    "feature-dev": {
      "enabled": true,
      "config": {
        "mode": "active"
      }
    },
    "frontend-design": {
      "enabled": true,
      "config": {
        "enabled": true
      }
    },
    "playwright": {
      "enabled": true,
      "config": {
        "headless": true,
        "auto-launch": false
      }
    },
    "github": {
      "enabled": true,
      "config": {
        "auto-sync": true
      }
    }
  },

  "logging": {
    "level": "info",
    "format": "json",
    "output": {
      "console": true,
      "files": true,
      "remote": false
    },
    "rotation": {
      "max-size": "100MB",
      "max-files": 10,
      "retention": "30d"
    },
    "components": {
      "claude": "info",
      "workflows": "info",
      "hooks": "info",
      "loops": "info",
      "mcp": "warn",
      "memory": "info",
      "agents": "info"
    }
  },

  "agents": {
    "default-type": "general-purpose",
    "timeout": "30m",
    "max-retries": 3,
    "error-recovery": "exponential-backoff"
  },

  "skills": {
    "auto-load": true,
    "timeout": "10m"
  },

  "commands": {
    "auto-complete": true,
    "history-limit": 1000
  },

  "git": {
    "auto-commit-messages": true,
    "require-signed-commits": false,
    "branch-prefix": "feature/",
    "main-branches": ["main", "master"]
  },

  "editor": {
    "format-on-save": true,
    "lint-on-save": false,
    "auto-complete": true,
    "theme": "system"
  },

  "terminal": {
    "width": 120,
    "theme": "system",
    "history": 1000
  },

  "performance": {
    "cache-enabled": true,
    "cache-ttl": "1h",
    "prefetch": true,
    "lazy-load": true
  },

  "security": {
    "verify-mcp-servers": true,
    "require-https": true,
    "secret-detection": true,
    "auto-redact-logs": true
  },

  "saas-development": {
    "module-documentation": {
      "format": "sparc",
      "validation": "auto",
      "auto-indexing": true
    },
    "epic-management": {
      "jira-sync": true,
      "auto-create-stories": true
    },
    "documentation-standards": {
      "sections": [
        "overview",
        "requirements",
        "architecture",
        "dependencies",
        "risks",
        "examples"
      ]
    }
  },

  "data-engineering": {
    "schema-validation": {
      "auto-check": true,
      "backwards-compatibility": true
    },
    "pipeline-monitoring": {
      "enabled": true,
      "check-interval": "30m"
    },
    "quality-rules": {
      "completeness": 100,
      "uniqueness": 100,
      "timeliness": 100
    }
  },

  "rules": {
    "enabled": true,
    "strict-mode": false,
    "auto-fix": true,
    "audit-trail": true
  },

  "notifications": {
    "enabled": true,
    "channels": ["console"],
    "levels": ["error", "warn"],
    "quiet-hours": false
  },

  "environment": {
    "NODE_ENV": "development",
    "DEBUG": false
  }
}